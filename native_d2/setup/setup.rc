// Native setup resources: icon, manifest (asInvoker, DPI aware), version information.
#include <winver.h>
#include "gen/version.h"

1 ICON "gen/voidgate.ico"
1 24 "setup.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VG_VER_MAJOR, VG_VER_MINOR, VG_VER_PATCH, 0
PRODUCTVERSION VG_VER_MAJOR, VG_VER_MINOR, VG_VER_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "XeRn10"
            VALUE "FileDescription", "Void Gate - Dishonored 2 mod setup"
            VALUE "FileVersion", VG_VER_STRING
            VALUE "InternalName", "VoidGateSetup"
            VALUE "LegalCopyright", "Copyright (c) 2026 XeRn10, MIT license"
            VALUE "OriginalFilename", "VoidGateSetup.exe"
            VALUE "ProductName", "Void Gate"
            VALUE "ProductVersion", VG_VER_STRING
            VALUE "Comments", "Source code: https://github.com/XeRn10/dishonored2-void-gate"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
