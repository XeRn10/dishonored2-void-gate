# Only the Void Gate sources are published from this folder: everything not listed below stays local
# (extracted game files, backups, other mods, the Dishonored 1 work, scratch files, toolchains).
/*
!/.gitignore
!/README.md
!/LICENSE
!/native_d2/
!/d2mods/
!/tools/
!/docs/

/native_d2/*.dll
/native_d2/*.lib
/native_d2/tests/*.exe
/native_d2/tests/*.pdb

/d2mods/*
!/d2mods/VoidGate/
/d2mods/VoidGate/art/_showcase.png

/tools/*
!/tools/bimage.py
!/tools/bimage_write.py
!/tools/d2click.py
!/tools/d2ctl.py
!/tools/d2datamine.py
!/tools/d2deps.py
!/tools/d2dump.py
!/tools/d2fall.py
!/tools/d2idx.py
!/tools/d2install.py
!/tools/d2live.py
!/tools/d2mod.py
!/tools/d2run.ps1
!/tools/d2test.py
!/tools/d2threads.py
!/tools/d2vel.py
!/tools/d2vel2.py
!/tools/d2vel3.py
!/tools/gdec.cmd
!/tools/gdec.py
!/tools/make_sig.py
!/tools/make_voidgate_art.py
!/tools/make_voidgate_cast.py
!/tools/make_voidgate_fx.py
!/tools/make_voidgate_lang.py
!/tools/make_voidgate_view.py
!/tools/vg_build.py
!/tools/vg_setup.py
!/tools/x64refs.py

/docs/*
!/docs/d2_*.md

# Stock game resources that another catalog needs too: the setup (and d2install) copy them from the player's own
# game at install time, so they are not redistributed here (mod.json "copy" entries; made by tools/d2deps.py)
/d2mods/VoidGate/files/generated/decls/material/models/effects/map_specific/void_house/
/d2mods/VoidGate/files/generated/decls/soundevent/sound_events/bsp/bsp_fixint/bsp_fixint_void/
/d2mods/VoidGate/files/generated/image/models/effects/textures/vector_field/
/d2mods/VoidGate/files/generated/staticparticlemodel/
/d2mods/VoidGate/files/generated/anim/
/d2mods/VoidGate/files/generated/basemodel/models/effects/
/d2mods/VoidGate/files/generated/decls/animbasic/
/d2mods/VoidGate/files/generated/decls/animset/
/d2mods/VoidGate/files/generated/decls/entitydef/models/effects/
/d2mods/VoidGate/files/generated/decls/md6def/models/effects/
/d2mods/VoidGate/files/generated/skeleton/

__pycache__/
*.pyc
